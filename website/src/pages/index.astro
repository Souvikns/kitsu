---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const workflowCode = `name: Kitsu AI Maintainer

on:
  pull_request:
    types: [opened]

jobs:
  run-kitsu:
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Use Kitsu Action
        uses: Souvikns/kitsu@main
        with:
          provider: openai
          api_key: \${{ secrets.KITSU_API_KEY }}
          model: gpt-4o-mini
          github_token: \${{ secrets.GITHUB_TOKEN }}`;
---

<Layout title="Kitsu - AI PR Reviewer for GitHub">
  <Nav />

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-brand">
            <img src="/kitsu/kitsu.svg" alt="Kitsu logo" class="hero-logo" width="120" height="120" />
          </div>
          <h1 class="hero-title">AI-powered code reviews for every pull request</h1>
          <p class="hero-description">
            Kitsu is your open-source AI PR reviewer for GitHub. It reads a pull request patch,
            posts inline review comments for actionable findings, and falls back to a general
            PR comment when a finding cannot be placed safely in the diff.
          </p>
          <div class="hero-actions">
            <a href="/kitsu/docs/" class="btn-primary">Get started</a>
            <a href="https://github.com/Souvikns/kitsu" class="btn-secondary" target="_blank" rel="noopener noreferrer">View on GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Usage Section -->
    <section class="usage">
      <div class="usage-container">
        <div class="section-header">
          <span class="section-eyebrow">SETUP GUIDE</span>
          <h2 class="section-title">Get up and running in minutes</h2>
        </div>

        <div class="usage-grid">
          <div class="usage-card">
            <div class="usage-step">
              <span class="step-number">1</span>
              <div class="step-content">
                <h3 class="step-title">Add your API key</h3>
                <p class="step-description">
                  Create a repository secret named KITSU_API_KEY that stores your provider API key.
                </p>
              </div>
            </div>
          </div>

          <div class="usage-card">
            <div class="usage-step">
              <span class="step-number">2</span>
              <div class="step-content">
                <h3 class="step-title">Create the workflow</h3>
                <p class="step-description">
                  Create a GitHub workflow file with the configuration below.
                </p>
              </div>
            </div>
          </div>

          <div class="usage-card">
            <div class="usage-step">
              <span class="step-number">3</span>
              <div class="step-content">
                <h3 class="step-title">Open a PR</h3>
                <p class="step-description">
                  Kitsu automatically reviews your pull requests and posts inline comments.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="code-example">
          <div class="code-card">
            <div class="code-header">
              <span class="code-filename">kitsu.yml</span>
            </div>
            <pre><code>{workflowCode}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="features-container">
        <div class="section-header">
          <span class="section-eyebrow">FEATURES</span>
          <h2 class="section-title">Why use Kitsu?</h2>
        </div>

        <div class="features-grid">
          <div class="feature-tile">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h3 class="feature-title">Inline PR Comments</h3>
            <p class="feature-description">Posts actionable review comments directly on the relevant lines of code.</p>
          </div>

          <div class="feature-tile">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            </div>
            <h3 class="feature-title">Fallback Comments</h3>
            <p class="feature-description">When a finding cannot be placed in the diff, it falls back to a general PR comment.</p>
          </div>

          <div class="feature-tile">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="feature-title">Multi-Provider Support</h3>
            <p class="feature-description">Works with OpenAI and Gemini. Choose the provider and model that fits your needs.</p>
          </div>

          <div class="feature-tile">
            <div class="feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9c1.66 0 3-4.03 3-9s-1.34-9-3-9m0 18c-1.66 0-3-4.03-3-9s1.34-9 3-9m-9 9a9 9 0 0 1 9-9"/></svg>
            </div>
            <h3 class="feature-title">Open Source</h3>
            <p class="feature-description">Fully open source and free. Self-host or fork to customize for your workflow.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    padding: 80px 24px;
    text-align: center;
  }

  .hero-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .hero-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-brand {
    margin-bottom: 24px;
  }

  .hero-logo {
    width: 120px;
    height: 120px;
  }

  .hero-title {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.5;
    color: #23251d;
    margin-bottom: 16px;
  }

  .hero-description {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.71;
    color: #4d4f46;
    margin-bottom: 24px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    background-color: #f7a501;
    color: #23251d;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    padding: 8px 16px;
    height: 40px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background-color 0.15s ease;
  }

  .btn-primary:hover {
    text-decoration: none;
    background-color: #dd9001;
  }

  .btn-secondary {
    background-color: #e5e7e0;
    color: #23251d;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    padding: 8px 16px;
    height: 40px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background-color 0.15s ease;
  }

  .btn-secondary:hover {
    text-decoration: none;
    background-color: #dcdfd2;
  }

  .usage {
    padding: 80px 24px;
  }

  .usage-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .section-eyebrow {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.33;
    text-transform: uppercase;
    color: #6c6e63;
    display: block;
    margin-bottom: 8px;
  }

  .section-title {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.33;
    letter-spacing: -0.6px;
    color: #23251d;
  }

  .usage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }

  .usage-card {
    background-color: #ffffff;
    border: 1px solid #bfc1b7;
    border-radius: 6px;
    padding: 24px;
  }

  .usage-step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .step-number {
    background-color: #f7a501;
    color: #23251d;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.56;
    color: #23251d;
    margin-bottom: 4px;
  }

  .step-description {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.71;
    color: #4d4f46;
    margin: 0;
  }

  .code-example {
    max-width: 800px;
    margin: 0 auto;
  }

  .code-card {
    background-color: #ffffff;
    border: 1px solid #bfc1b7;
    border-radius: 6px;
    overflow: hidden;
  }

  .code-header {
    background-color: #e5e7e0;
    padding: 8px 16px;
    border-bottom: 1px solid #dcdfd2;
  }

  .code-filename {
    font-size: 13px;
    font-weight: 500;
    color: #6c6e63;
    font-family: 'Source Code Pro', ui-monospace, monospace;
  }

  .code-card pre {
    margin: 0;
    border-radius: 0;
    background-color: #23251d;
  }

  .features {
    padding: 80px 24px;
  }

  .features-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .feature-tile {
    background-color: #ffffff;
    border: 1px solid #bfc1b7;
    border-radius: 6px;
    padding: 20px;
  }

  .feature-icon {
    color: #f7a501;
    margin-bottom: 12px;
  }

  .feature-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.56;
    color: #23251d;
    margin-bottom: 4px;
  }

  .feature-description {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.71;
    color: #4d4f46;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 48px 16px;
    }
    .hero-title {
      font-size: 28px;
    }
    .usage {
      padding: 48px 16px;
    }
    .usage-grid {
      grid-template-columns: 1fr;
    }
    .features {
      padding: 48px 16px;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 32px 12px;
    }
    .usage {
      padding: 32px 12px;
    }
    .features {
      padding: 32px 12px;
    }
  }
</style>
