---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { marked } from 'marked';
import { readFileSync } from 'fs';
import { join } from 'path';

// Read README.md from repo root
const readmePath = join(process.cwd(), '..', 'README.md');
const readmeContent = readFileSync(readmePath, 'utf-8');

// Parse markdown to HTML
const htmlContent = marked(readmeContent, { headerIds: true, mangle: false });

// Extract headings for TOC
const headings: { level: number; text: string; id: string }[] = [];
const headingRegex = /<h([1-6])[^>]*>(.*?)<\/h\1>/g;
let match;
while ((match = headingRegex.exec(htmlContent)) !== null) {
  const level = parseInt(match[1]);
  const text = match[2].replace(/<[^>]*>/g, '');
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  headings.push({ level, text, id });
}

// Replace heading IDs in HTML to match TOC
let processedHtml = htmlContent;
headings.forEach(h => {
  const regex = new RegExp(`<h${h.level}[^>]*>${h.text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}</h${h.level}>`, 'g');
  processedHtml = processedHtml.replace(regex, `<h${h.level} id="${h.id}">${h.text}</h${h.level}>`);
});

// Fix image src paths: rewrite GitHub blob URLs to raw, and relative ./assets/ to /kitsu/assets/
processedHtml = processedHtml
  .replace(/src="https:\/\/github\.com\/Souvikns\/kitsu\/blob\/main\/([^"]+)"/g, 'src="https://raw.githubusercontent.com/Souvikns/kitsu/main/$1"')
  .replace(/src="\.\.?\/assets\//g, 'src="/kitsu/assets/');
---

<Layout title="Documentation - Kitsu">
  <Nav />

  <main class="docs-layout">
    <!-- Mobile TOC Toggle -->
    <button class="toc-toggle" id="tocToggle" aria-expanded="false" aria-controls="tocSidebar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <span>Table of Contents</span>
    </button>

    <div class="docs-container">
      <!-- Sidebar -->
      <aside class="doc-sidebar" id="tocSidebar">
        <div class="sidebar-content">
          <p class="sidebar-label">On this page</p>
          <nav class="toc-nav" aria-label="Table of contents">
            <ul class="toc-list">
              {headings.map(h => (
                <li class={`toc-item toc-level-${h.level}`}>
                  <a href={`#${h.id}`} class="toc-link">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>

      <!-- Main Content -->
      <article class="doc-article">
        <div class="doc-card">
          <div class="doc-content" set:html={processedHtml} />
        </div>
      </article>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const tocToggle = document.getElementById('tocToggle');
  const tocSidebar = document.getElementById('tocSidebar');

  tocToggle?.addEventListener('click', () => {
    const expanded = tocToggle.getAttribute('aria-expanded') === 'true';
    tocToggle.setAttribute('aria-expanded', String(!expanded));
    tocSidebar?.classList.toggle('open');
  });

  // Close sidebar when clicking a link on mobile
  document.querySelectorAll('.toc-link').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768) {
        tocSidebar?.classList.remove('open');
        tocToggle?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  .docs-layout {
    min-height: calc(100vh - 56px);
  }

  .toc-toggle {
    display: none;
    align-items: center;
    gap: var(--spacing-sm);
    width: 100%;
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-surface-soft);
    border: none;
    border-bottom: 1px solid var(--color-hairline-soft);
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .toc-toggle:hover {
    background-color: var(--color-hairline-soft);
  }

  .docs-container {
    display: flex;
    max-width: 1160px;
    margin: 0 auto;
    padding: var(--spacing-xl);
    gap: var(--spacing-xl);
  }

  .doc-sidebar {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: 80px;
    align-self: flex-start;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .sidebar-content {
    padding: var(--spacing-md) 0;
  }

  .sidebar-label {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.33;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: var(--spacing-md);
    padding: 0 var(--spacing-sm);
  }

  .toc-list {
    list-style: none;
  }

  .toc-item {
    margin-bottom: var(--spacing-xs);
  }

  .toc-link {
    display: block;
    padding: 6px var(--spacing-sm);
    color: var(--color-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.43;
    text-decoration: none;
    border-radius: var(--rounded-sm);
    transition: background-color 0.15s ease;
  }

  .toc-link:hover {
    text-decoration: none;
    background-color: var(--color-surface-soft);
    color: var(--color-ink);
  }

  .toc-level-2 {
    padding-left: var(--spacing-md);
  }

  .toc-level-3 {
    padding-left: var(--spacing-lg);
  }

  .doc-article {
    flex: 1;
    min-width: 0;
  }

  .doc-card {
    background-color: var(--color-surface-doc);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: var(--spacing-xl);
  }

  .doc-content :global(h1) {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline-soft);
  }

  .doc-content :global(h2) {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.33;
    letter-spacing: -0.6px;
    margin-top: var(--spacing-xxl);
    margin-bottom: var(--spacing-md);
  }

  .doc-content :global(h3) {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.5px;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .doc-content :global(h4) {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
  }

  .doc-content :global(p) {
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: var(--spacing-md);
  }

  .doc-content :global(ul),
  .doc-content :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-xl);
  }

  .doc-content :global(li) {
    margin-bottom: var(--spacing-xs);
    line-height: 1.5;
  }

  .doc-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--spacing-md) 0;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    overflow: hidden;
  }

  .doc-content :global(th) {
    background-color: var(--color-surface-soft);
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 700;
    text-align: left;
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline);
  }

  .doc-content :global(td) {
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline-soft);
    font-size: 14px;
    line-height: 1.5;
  }

  .doc-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .doc-content :global(pre) {
    margin: var(--spacing-md) 0;
    background-color: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: 16px 20px;
    border-radius: var(--rounded-md);
    overflow-x: auto;
  }

  .doc-content :global(code) {
    background-color: var(--color-surface-soft);
    color: var(--color-ink);
    padding: 2px 6px;
    border-radius: var(--rounded-xs);
    font-size: 14px;
    font-weight: 500;
  }

  .doc-content :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
    border-radius: 0;
  }

  .doc-content :global(a) {
    color: var(--color-link-teal);
    text-decoration: none;
  }

  .doc-content :global(a:hover) {
    text-decoration: underline;
  }

  .doc-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--rounded-md);
  }

  .doc-content :global(blockquote) {
    background-color: var(--color-accent-blue-soft);
    border-left: 4px solid var(--color-accent-blue);
    padding: var(--spacing-md) var(--spacing-lg);
    margin: var(--spacing-md) 0;
    border-radius: 0 var(--rounded-md) var(--rounded-md) 0;
  }

  .doc-content :global(blockquote p) {
    margin: 0;
  }

  @media (max-width: 1024px) {
    .docs-container {
      padding: var(--spacing-lg);
    }
  }

  @media (max-width: 768px) {
    .toc-toggle {
      display: flex;
    }

    .doc-sidebar {
      position: fixed;
      top: 56px;
      left: 0;
      width: 100%;
      max-height: calc(100vh - 56px);
      background-color: var(--color-canvas);
      z-index: 50;
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.2s ease, opacity 0.2s ease;
      border-bottom: 1px solid var(--color-hairline);
      padding: var(--spacing-lg);
    }

    .doc-sidebar.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .docs-container {
      padding: var(--spacing-md);
      flex-direction: column;
    }

    .doc-card {
      padding: var(--spacing-lg);
    }

    .doc-content :global(h1) {
      font-size: 28px;
    }

    .doc-content :global(h2) {
      font-size: 22px;
    }
  }

  @media (max-width: 480px) {
    .doc-card {
      padding: var(--spacing-md);
      border-radius: var(--rounded-sm);
    }

    .doc-content :global(h1) {
      font-size: 24px;
    }

    .doc-content :global(pre) {
      padding: 12px 16px;
      font-size: 13px;
    }
  }
</style>
